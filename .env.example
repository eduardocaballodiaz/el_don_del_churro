# Copia este archivo como .env.local y rellena los valores.
# .env.local NUNCA se sube a git (contiene secretos).

# Clave de la API de Resend (https://resend.com → API Keys). Permiso: solo envío.
RESEND_API_KEY=

# A quién llegan los mensajes del formulario.
CONTACTO_DESTINO=info@eldondelchurro.com

# Desde qué dirección se envían. Hasta verificar el dominio en Resend:
# onboarding@resend.dev (solo puede enviar al correo del titular de la cuenta de Resend).
# Después: web@eldondelchurro.com
CONTACTO_REMITENTE=onboarding@resend.dev

# Solo para pruebas: 1 = no envía nada de verdad.
# CONTACTO_SIMULADO=1

# Solo el día del lanzamiento en eldondelchurro.com: 1 = los buscadores pueden indexar.
# Mientras no esté, la web pide a Google que no la indexe (web de pruebas).
# PERMITIR_INDEXAR=1
